expectedCounts := [9928, 32, 32, 9965, 9965];\n\n    for k from 1 to 5
 do\n        if minima[k] <> expectedMinima[k]\n           or argmins[
k] <> expectedAt[k]\n           or counts[k] <> expectedCounts[k] then
\n            error \"Certificate mismatch: [name,count,minimum,index]
=%1\",\n                  [labels[k],counts[k],minima[k],argmins[k]];
\n        end if;\n\n        print([\n            labels[k], \"PASS\",
