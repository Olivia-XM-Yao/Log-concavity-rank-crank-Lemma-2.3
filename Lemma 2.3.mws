0] := 1;\n\n    # Euler's pentagonal recurrence.\n    for n from 1 to \+
Nmax do\n        total := 0;\n        r := 1;\n        sgn := 1;\n\n  \+
      while true do\n            g := iquo(r*(3*r-1), 2);\n\n         \+
   if g > n then\n                break;\n            end if;\n\n     \+
       total := total+sgn*Ptab[n-g];\n\n            if g+r <= n then\n
                total := total+sgn*Ptab[n-g-r];\n            end if;\n
\n            r := r+1;\n            sgn := -sgn;\n        end do;\n\n
        Ptab[n] := total;\n    end do;\n\n    # a(k) = p(k)-p(k-1), b(
k) = p(k)-p(k-2).\n    # The convention is p(k)=0 for k<0.\n    Atab :
= Array(0..Nmax, datatype=anything, fill=0);\n    Btab := Array(0..Nma
x, datatype=anything, fill=0);\n\n    Atab[0] := 1;\n    Btab[0] := 1;
\n\n    for k from 1 to Nmax do\n        Atab[k] := Ptab[k]-Ptab[k-1];
\n\n        if k = 1 then\n            Btab[k] := Ptab[k];\n        el
se\n            Btab[k] := Ptab[k]-Ptab[k-2];\n        end if;\n    en
d do;\n\n    labels := [\"E\", \"U_R0\", \"V_R0\", \"U_Rs\", \"V_Rs\"]
;\n\n    minima := Array(1..5, datatype=anything, fill=0);\n    argmin
s := Array(1..5, datatype=anything, fill=0);\n    counts := Array(1..5
, datatype=anything, fill=0);\n\n    # Check E(t) > 0 for 72 <= t <= 9
999.\n    for t from 72 to 9999 do\n        value := Atab[t]^2-Atab[t-
1]*Atab[t+1]\n                 -2*Atab[t]+Atab[t-1]+1;\n\n        if v
alue <= 0 then\n            error \"Nonpositive E(t): [t,E(t)]=%1\", [
t,value];\n        end if;\n\n        if argmins[1] = 0 or value < min
ima[1] then\n            minima[1] := value;\n            argmins[1] :
= t;\n        end if;\n\n        counts[1] := counts[1]+1;\n    end do
;\n\n    X0 := Atab[72];\n    Y0 := Atab[71];\n\n    if X0 <> 695578 o
r Y0 <> 609237 then\n        error \"Incorrect reference values: [a(72
),a(71)]=%1\",\n              [X0,Y0];\n    end if;\n\n    # U_s(X,Y) \+
= Y*b(s)-X*b(s-2).\n    # V_s(X,Y) = Y^2*b(s+2)-2*X*Y*b(s)+X^2*b(s-2).
\n    # For Y>0, these are denominator-cleared forms of:\n    # (X/Y)*
b(s-2) < b(s), and q_s(X/Y) > 0.\n    for s from 3 to 9999 do\n       \+
 if s <= 34 then\n            X := X0;\n            Y := Y0;\n        \+
    baseIdx := 2;\n        else\n            X := Atab[2*s+4];\n      \+
      Y := Atab[2*s+3];\n            baseIdx := 4;\n        end if;\n
\n        if Y <= 0 then\n            error \"Nonpositive ratio denomi
nator at s=%1\", s;\n        end if;\n\n        uv := [\n            Y
*Btab[s]-X*Btab[s-2],\n            Y^2*Btab[s+2]-2*X*Y*Btab[s]+X^2*Bta
b[s-2]\n        ];\n\n        for k from 1 to 2 do\n            idx :=
 baseIdx+k-1;\n            value := uv[k];\n\n            if value <= \+
0 then\n                error \"Nonpositive certificate: [name,s,value
]=%1\",\n                      [labels[idx],s,value];\n            end
 if;\n\n            if argmins[idx] = 0 or value < minima[idx] then\n \+
               minima[idx] := value;\n                argmins[idx] := \+
s;\n            end if;\n\n            counts[idx] := counts[idx]+1;\n
        end do;\n    end do;\n\n    # Exact minima and first attaining
 indices from Appendix A.\n    expectedMinima := [\n        27986845,
